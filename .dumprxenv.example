# .dumprxenv.example
# Copy this file to .dumprxenv and fill in your credentials.
# Do NOT commit your actual .dumprxenv file to git!

# GitLab Configuration
export GITLAB_TOKEN=""
export GITLAB_INSTANCE="gitlab.com"
export GITLAB_GROUP="" # Optional: Your GitLab group name. If empty, your username will be used.

# GitHub Configuration
# A fine-grained or classic PAT. Your SSH key must be registered on GitHub.
export GITHUB_TOKEN=""
export GITHUB_ORG="" # Optional: Your GitHub organization name. If empty, your personal account is used.

# Telegram Configuration
export TG_TOKEN=""
export TG_CHAT="" # Optional: Your Telegram chat ID. If empty, "@DumprXDumps" will be used.

# Bloatware Cleanup Settings
# export CLEANUP_BLOAT="true"  # Auto-detect and remove bloatware, deletable apps & Google Apps before pushing (default: true)


